# ==============================================================================
# AEGISMESH CONFIGURATION ENVIRONMENT EXAMPLE
# Copy to .env for local development. Never commit .env with real credentials.
# ==============================================================================

# Application
APP_NAME="AegisMesh"
APP_ENV="development" # development | testing | production
LOG_LEVEL="INFO"       # DEBUG | INFO | WARNING | ERROR | CRITICAL
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Database (PostgreSQL)
# Async URL for FastAPI SQLAlchemy 2 session
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/aegismesh"
# Sync URL for Alembic migrations and tooling
DATABASE_URL_SYNC="postgresql+psycopg://postgres:postgres@localhost:5432/aegismesh"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO="false"

# Supabase Auth & JWT Validation
# In development, SUPABASE_AUTH_ENABLED=false enables local dev mode with an explicit
# mock security context, clearly logged as INSECURE_DEV_MODE. In production, this MUST
# be true and valid SUPABASE credentials must be supplied.
SUPABASE_AUTH_ENABLED="false"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="anon-public-key-placeholder"
SUPABASE_JWT_SECRET="development-jwt-secret-placeholder-minimum-32-chars-long"
SUPABASE_JWT_ALGORITHM="HS256"

# VirusTotal Threat Intelligence (Optional / External)
# Only accessed via ThreatIntelProvider port. Consent level enforced (L0/L1/L2).
VIRUSTOTAL_API_KEY=""

# Consent & Privacy Defaults (L0: purely local, L1: hash/reputation lookup, L2: sample upload)
DEFAULT_CONSENT_LEVEL="L0"
